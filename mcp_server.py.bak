# MAIN ENTRY POINT
# =========================================================================

async def main():
    """Run MCP server"""
    mcp = AbletonBrainMCP()
    print("[MCP] Ableton Brain MCP Server starting...")
    print("[MCP] Available tools: 40+")
    print("[MCP] Connect to Ableton Remote Script on port 9877")
    await mcp.run()


if __name__ == '__main__':
    asyncio.run(main())