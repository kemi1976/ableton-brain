  "presets": {
    "default": {
      "name": "Default Mapping",
      "description": "Basic MIDI controller setup",
      "mappings": [
        {
          "physical_control": "knob_1",
          "daw_parameter": "filter_cutoff",
          "curve_profile": "linear",
          "range_min": 0,
          "range_max": 127
        },
        {
          "physical_control": "knob_2",
          "daw_parameter": "resonance",
          "curve_profile": "log",
          "range_min": 0,
          "range_max": 127
        },
        {
          "physical_control": "pad_1",
          "daw_parameter": "note_c4",
          "range_min": 0,
          "range_max": 127
        }
      ]
    },
    "dj_mode": {
      "name": "DJ Mode",
      "description": "DJ-style mixer controls",
      "mappings": [
        {
          "physical_control": "knob_1",
          "daw_parameter": "channel_volume_1",
          "curve_profile": "linear",
          "range_min": 0,
          "range_max": 127
        },
        {
          "physical_control": "knob_2",
          "daw_parameter": "channel_volume_2",
          "curve_profile": "linear",
          "range_min": 0,
          "range_max": 127
        },
        {
          "physical_control": "knob_3",
          "daw_parameter": "crossfader",
          "curve_profile": "exp",
          "range_min": 0,
          "range_max": 127
        }
      ]
    },
    "bass_producer": {
      "name": "Bass Producer",
      "description": "Optimized for bass music production",
      "mappings": [
        {
          "physical_control": "knob_1",
          "daw_parameter": "sub_bass_level",
          "curve_profile": "log",
          "range_min": -12,
          "range_max": 12
        },
        {
          "physical_control": "knob_2",
          "daw_parameter": "distortion_drive",
          "curve_profile": "exp",
          "range_min": 0,
          "range_max": 100
        }
      ]
    }
  }
}